# ==============================================================================
# YUNTA — PLANTILLA DE CONFIGURACIÓN NEUTRAL (.env.example)
# ==============================================================================

# 1. Modelo de IA Principal (LLM)
LLM_MODEL=tu_modelo_elegido
LLM_API_KEY=tu_api_key_aqui
# LLM_API_BASE=http://localhost:8000/v1

# 1b. Proveedor Secundario (fallback si el primario falla: 429/503/cuota)
# Puede usar otro endpoint y credencial propios (ej. plan de código Z.AI/BigModel)
# LLM_FALLBACK_MODEL=openai/glm-5.3
# LLM_FALLBACK_API_BASE=https://api.z.ai/api/coding/paas/v4
# LLM_FALLBACK_API_KEY=tu_fallback_api_key

# 2. Servicio de Transcripción de Voz (STT Audio a Texto)
VOICE_MODEL=tu_modelo_de_voz
VOICE_API_BASE=tu_endpoint_stt_aqui
VOICE_API_KEY=tu_voice_api_key_aqui
VOICE_LANGUAGE=es

# 3. Servicio de Síntesis de Voz (TTS Texto a Voz)
# TTS_MODEL=@cf/meta/mms-tts-spa
# TTS_API_BASE=https://yunta-stt-worker.beroiza79.workers.dev/v1
# TTS_VOICE=es-CL-CatalinaNeural

# 4. Gatekeeper de Seguridad / Decisiones Rápidas JEV (opcional, agnóstico por diseño)
# JEV_MODEL=tu_modelo_de_decision  # ej. ollama/qwen2.5:0.5b, openai/gpt-4o-mini
# JEV_API_BASE=tu_endpoint_aqui    # ej. http://localhost:11434/v1, https://tu-servicio-decisiones/v1
# JEV_API_KEY=tu_api_key_aqui
# JEV_GATEKEEPER=1



